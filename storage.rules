rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de produtos — só admin pode escrever, qualquer um pode ler
    match /produtos/{produtoId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024   // máx 5MB
        && request.resource.contentType.matches('image/.*');
    }

  }
}
